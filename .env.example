# =====================================================================
# 여백 배포 환경변수
#   cp .env.example .env  →  ./scripts/gen-secrets.sh  →  아래 빈 값 채우기
#   이 파일(.env.example)에는 실제 값을 넣지 마세요.
# =====================================================================

# ---- 사이트 주소 -----------------------------------------------------
# 브라우저가 접속하는 주소. 프론트 빌드에 들어가므로 바꾸면 다시 빌드해야 함
#   로컬 테스트:   http://localhost:8088
#   서버(IP):      http://<고정IP>
#   서버(도메인):  https://yeoback.example.com
PUBLIC_URL=http://localhost:8088

# Caddy가 응답할 주소
#   :80              → HTTP만 (로컬, IP 접속)
#   도메인 이름만    → HTTPS 인증서 자동 발급 (예: yeoback.example.com)
SITE_ADDRESS=:80

# 호스트에 열 포트 (로컬에서 80이 사용 중이면 8088 등으로)
HTTP_PORT=8088
HTTPS_PORT=8443

# ---- 팀 레포 ---------------------------------------------------------
# 서버: ./app (fetch-app.sh가 받아옴) / 로컬 테스트: ../Yeoback-clone
APP_DIR=./app
APP_REPO=https://github.com/keumbyeol/Yeoback-2026.git
APP_REF=dev

# ---- 자동 생성 (scripts/gen-secrets.sh가 채움) -----------------------
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
JWT_SECRET_KEY=
ACCOUNT_ENCRYPTION_KEY=
AI_INTERNAL_API_KEY=

# ---- 직접 넣는 값 ----------------------------------------------------
# Google AI Studio 무료 등급 키 (AI 일정 생성, AI 챗봇)
GEMINI_API_KEY=
# 사용할 Gemini 모델 (팀 코드의 gemini-2.5-flash는 신규 키에서 막힘)
GEMINI_MODEL=gemini-3.5-flash-lite
# 카카오 디벨로퍼스 > 플랫폼 키 > JavaScript 키 (지도)
KAKAO_JS_KEY=

# ---- 선택 (없어도 서버는 뜸) -----------------------------------------
# 공공데이터포털 TourAPI (새 지역 데이터 수집할 때만 필요)
TOUR_API_KEY=
# 이메일 초대 발송용 Gmail 주소와 앱 비밀번호
MAIL_USERNAME=
MAIL_PASSWORD=
